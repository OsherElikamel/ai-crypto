# Server
PORT=8080
ORIGIN=http://localhost:5173

# Database (overridden by Docker Compose — only needed for local dev without Docker)
MONGODB_URI=mongodb://localhost:27017/ai-crypto

# Auth
JWT_SECRET=change_me_in_production

# CoinGecko (optional — increases rate limits, works without it)
CG_API_KEY=

# CryptoPanic (required for live crypto news)
CRYPTOPANIC_TOKEN=

# OpenRouter (required for AI-generated insights)
OPENROUTER_KEY=

# Reddit (optional — public API works without these)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
